[
  {"name": "transactionId", "type": "STRING", "mode": "REQUIRED", "description": "Stedi transaction id of the 940 - natural key"},
  {"name": "fileExecutionId", "type": "STRING", "description": "Stedi file execution that produced the 940"},
  {"name": "processedAt", "type": "TIMESTAMP", "description": "When Stedi processed (sent) the 940"},
  {"name": "partnershipId", "type": "STRING", "description": "Stedi partnership, e.g. americanflat_Taylored-SC"},
  {"name": "warehouse", "type": "STRING", "description": "FON / NJ / SC / NL, from the partnership - same codes as warehouse.shipments_945"},
  {"name": "orderStatusCode", "type": "STRING", "description": "W05-01: N = new order"},
  {"name": "depositorOrderNumber", "type": "STRING", "description": "W05-02 - the order number the warehouse echoes back as the 945 orderNumber"},
  {"name": "purchaseOrderNumber", "type": "STRING", "description": "W05-03 - marketplace PO / Shopify order id; often FedEx Ref#3"},
  {"name": "marketplaceRaw", "type": "STRING", "description": "N9*IT - the marketplace as sent: ACNDA_TGTPL, AMAZON.COM, WAYFAIR LLC, SHOPIFY, WALMARTCOM, MACYS, AMAZON.FBA, AMAZON.VC. warehouse.shipments_940 maps it to a channel code"},
  {"name": "department", "type": "STRING", "description": "N9*DP - department; only Target fills it ('Target')"},
  {"name": "internalVendorNumber", "type": "STRING", "description": "N9*IA"},
  {"name": "customerOrderNumber", "type": "STRING", "description": "N9*CO"},
  {"name": "dataSource", "type": "STRING", "description": "N9*S2"},
  {"name": "n9", "type": "JSON", "description": "Every header N9 as {qualifier: value}"},
  {"name": "shipToName", "type": "STRING", "description": "N1*ST name"},
  {"name": "shipToAddress1", "type": "STRING"},
  {"name": "shipToCity", "type": "STRING"},
  {"name": "shipToState", "type": "STRING"},
  {"name": "shipToPostalCode", "type": "STRING"},
  {"name": "shipToCountry", "type": "STRING"},
  {"name": "orderedDate", "type": "DATE", "description": "G62*52"},
  {"name": "requestedShipDate", "type": "DATE", "description": "G62*10"},
  {"name": "cancelAfterDate", "type": "DATE", "description": "G62*01"},
  {"name": "carrierScac", "type": "STRING", "description": "W66-10"},
  {"name": "routing", "type": "STRING", "description": "W66-05, e.g. FDX90"},
  {"name": "transportMethod", "type": "STRING", "description": "W66-02"},
  {"name": "paymentMethod", "type": "STRING", "description": "W66-01, e.g. PP"},
  {"name": "lines", "type": "RECORD", "mode": "REPEATED", "description": "W01 line items", "fields": [
    {"name": "lineSeq", "type": "INTEGER", "description": "LX number"},
    {"name": "sku", "type": "STRING", "description": "W01 VN"},
    {"name": "customerItemNumber", "type": "STRING", "description": "W01 CN"},
    {"name": "upc", "type": "STRING", "description": "W01-03, else W01 UP"},
    {"name": "quantityOrdered", "type": "FLOAT"},
    {"name": "uom", "type": "STRING"},
    {"name": "description", "type": "STRING", "description": "G69"},
    {"name": "lineItemRef", "type": "STRING", "description": "line N9*LI"},
    {"name": "amount", "type": "NUMERIC", "description": "AMT*LI"}
  ]},
  {"name": "_ingested_at", "type": "TIMESTAMP", "description": "When the row was loaded (UTC)"},
  {"name": "_ingested_by", "type": "STRING", "description": "gcloud account that ran the load"}
]
